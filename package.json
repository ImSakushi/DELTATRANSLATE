{
  "name": "deltatranslate",
  "productName": "DELTATRANSLATE",
  "version": "1.0.1",
  "desktopName": "DELTATRANSLATE",
  "description": "Éditeur de traduction pour tous les chapitres de DELTARUNE avec preview fidèle au jeu",
  "author": "ImSakushi",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test updater.test.js extraction/chapter-scope.test.mjs extraction/code-overrides.test.mjs",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --universal --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1"
  },
  "build": {
    "appId": "fr.imsakushi.deltatranslate",
    "productName": "DELTATRANSLATE",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "electronUpdaterCompatibility": ">=2.16",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "utmt-manager.js",
      "extraction/**/*",
      "src/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ImSakushi",
        "repo": "DELTATRANSLATE"
      }
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "icon": "src/assets/deltatranslate-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-Windows-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-Windows-Portable-${arch}.${ext}"
    },
    "mac": {
      "icon": "src/assets/deltatranslate-icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "icon": "src/assets/deltatranslate-icon.png",
      "category": "Development",
      "maintainer": "ImSakushi <116188905+ImSakushi@users.noreply.github.com>",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Linux-${arch}.${ext}"
    }
  }
}
